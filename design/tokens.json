{
  "about": "Beach Sync design tokens: the single source for the look. Sizes are CSS px on a 390-wide phone, which map 1:1 to Android dp (and font px to sp). Dark only for now.",
  "color": {
    "bg": "#0A0C0F",
    "surface": "#12161B",
    "border": "#222932",
    "track": "#1A1F26",
    "grid": "#2A323C",
    "gridFaint": "#1F252D",
    "text": "#ECEFF2",
    "textSecondary": "#C4CBD2",
    "muted": "#8B95A1",
    "faded": "#6B7580",
    "faint": "#4A5562",
    "accent": "#C8FF4D",
    "accentPressed": "#E2FF9E",
    "accentAlternatives": [
      "#5CE1FF",
      "#FF7A45"
    ],
    "onAccent": "#0A0C0F",
    "warn": "#FFB547",
    "accentWash": "rgba(200, 255, 77, 0.07)",
    "status": {
      "inSync": {
        "color": "accent",
        "mark": "● filled dot with glow"
      },
      "holding": {
        "color": "accent",
        "mark": "○ open dot",
        "note": "amber (warn) by itself once its estimate passes 5 ms"
      },
      "privacy": {
        "color": "textSecondary",
        "mark": "lock icon",
        "note": "Satellites off by choice. Neutral at any error: never amber, never fault wording."
      },
      "warn": {
        "color": "warn",
        "mark": "▲ triangle",
        "states": [
          "Internet time",
          "Rejoining",
          "Silent: over the limit",
          "any state above 5 ms"
        ]
      },
      "danger": {
        "color": "danger",
        "mark": "✕ cross",
        "states": [
          "Clock check failed",
          "Not in sync"
        ]
      },
      "note": "Badge rule: words + mark + colour, never colour alone. Fill is the colour at 7-8% opacity."
    },
    "lane": {
      "clock": {
        "color": "accent",
        "mark": "● filled circle"
      },
      "audio": {
        "color": "#FFB547",
        "mark": "■ filled square"
      },
      "net": {
        "color": "#5CE1FF",
        "mark": "▲ triangle"
      },
      "output": {
        "color": "#B79CFF",
        "mark": "○ open circle"
      },
      "note": "Lanes always show colour AND mark AND name, so colour is never the only cue.",
      "screen": {
        "color": "#FF8FB1",
        "mark": "◆ diamond"
      }
    },
    "gnss": {
      "gps": "accent",
      "galileo": "#5CE1FF",
      "beidou": "#B79CFF"
    },
    "danger": "#FF6B6B",
    "minimalBg": "#000000"
  },
  "font": {
    "ui": {
      "family": "Space Grotesk",
      "weights": [
        400,
        500,
        700
      ],
      "source": "Google Fonts (SIL OFL)"
    },
    "numeric": {
      "family": "JetBrains Mono",
      "weights": [
        400,
        600
      ],
      "source": "Google Fonts (SIL OFL)"
    },
    "rule": "Every number that changes live is JetBrains Mono, so digits don't jitter as they update."
  },
  "type": {
    "screenTitle": {
      "font": "ui",
      "size": 18,
      "weight": 700
    },
    "eyebrow": {
      "font": "ui",
      "size": 11,
      "weight": 500,
      "tracking": "0.16em",
      "case": "upper",
      "color": "muted"
    },
    "cardLabel": {
      "font": "ui",
      "size": 10.5,
      "weight": 400,
      "tracking": "0.16em",
      "case": "upper",
      "color": "muted"
    },
    "body": {
      "font": "ui",
      "size": 12.5,
      "weight": 400
    },
    "bodyStrong": {
      "font": "ui",
      "size": 14,
      "weight": 500
    },
    "small": {
      "font": "ui",
      "size": 11,
      "weight": 400,
      "color": "muted"
    },
    "badge": {
      "font": "ui",
      "size": 14,
      "weight": 700,
      "tracking": "0.12em",
      "case": "upper"
    },
    "value": {
      "font": "numeric",
      "size": 15,
      "weight": 600
    },
    "valueSmall": {
      "font": "numeric",
      "size": 12,
      "weight": 400
    },
    "clock": {
      "font": "numeric",
      "size": 30,
      "weight": 600,
      "tracking": "-0.02em"
    },
    "clockFraction": {
      "font": "numeric",
      "size": 15,
      "weight": 400,
      "note": "digits finer than the error estimate use color.faded"
    },
    "hero": {
      "font": "numeric",
      "size": 46,
      "weight": 600,
      "tracking": "-0.02em"
    },
    "clockMinimal": {
      "font": "numeric",
      "size": 56,
      "weight": 600,
      "tracking": "-0.03em",
      "note": "Minimal level: whole seconds only"
    },
    "clockZone": {
      "font": "ui",
      "size": 10.5,
      "tracking": "0.2em",
      "case": "upper",
      "color": "muted",
      "note": "GMT or BST, above the digits"
    },
    "clockLocal": {
      "font": "numeric",
      "size": 11,
      "color": "muted",
      "note": "local time beneath: \"23:43:51 CET · local\""
    },
    "bezelTop": {
      "font": "ui",
      "size": 10,
      "weight": 500,
      "tracking": "0.24em",
      "color": "textSecondary",
      "text": "TEDDINGTON · GREENWICH",
      "note": "on the dial, sizes in dial units of a 252-unit dial drawn at 206 px; curved along the top outside the tick ring (radius 113)"
    },
    "bezelBottom": {
      "font": "numeric",
      "size": 10,
      "tracking": "0.12em",
      "color": "accent",
      "text": "FLOWTIME ±<error>",
      "note": "curved along the bottom (radius 119), reading upright"
    }
  },
  "radius": {
    "card": 14,
    "tile": 12,
    "control": 10,
    "switchTrack": 13,
    "pill": 999
  },
  "space": {
    "screenPadding": {
      "top": 14,
      "side": 18,
      "bottom": 18
    },
    "stackGap": 10,
    "cardPadding": {
      "vertical": 12,
      "horizontal": 14
    },
    "rowGap": 6,
    "touchTarget": 44,
    "note": "Every tappable thing is at least 44 x 44, even where it looks smaller."
  },
  "stroke": {
    "card": 1,
    "control": 1,
    "emphasis": 1.5
  },
  "elevation": "none: flat surfaces with 1 px borders, no shadows except the glow on live status dots (box-shadow 0 0 12px in the dot's colour)",
  "screenLevels": {
    "Full": "everything live: per-frame clock and sweep, glows, traces at 4 Hz",
    "Reduced": "no glows or sweep animation, clock to 0.1 s at 4 Hz, traces at 1 Hz",
    "Minimal": "pure black (#000000), text only, one update a second, no animation, event log as plain text",
    "Off": "screen off; music unaffected (notification design is later)"
  }
}