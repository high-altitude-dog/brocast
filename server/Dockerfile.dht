# The server's identity over HyperDHT, in its own container. It shares brocast-test's network so it can reach the stream server,
# and needs no published port. Keep its seed on a private volume. See README.md.
FROM node:22-slim
ENV NODE_ENV=production
RUN mkdir -p /app /identity && chown 65534:65534 /identity
COPY dht/package.json dht/gateway.js /app/
WORKDIR /app
RUN npm install --omit=dev --no-audit --no-fund
USER 65534:65534
ENTRYPOINT ["node", "/app/gateway.js"]
