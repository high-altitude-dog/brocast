# A blind relay on the public HyperDHT (user, 15 Nov): phones that can't reach each other directly (client-isolated Wi-Fi,
# two randomized NATs) pass encrypted packets through it. It can't read them. Its key is on a private volume. See README.md.
FROM node:22-slim
ENV NODE_ENV=production RELAY_SEED=/identity/relay-seed
RUN mkdir -p /app /identity && chown 65534:65534 /identity
COPY relay/package.json relay/relay.js /app/
WORKDIR /app
RUN npm install --omit=dev --no-audit --no-fund
USER 65534:65534
ENTRYPOINT ["node", "/app/relay.js"]
